\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The first 6 panels compare the number histograms of CModel SNR between the observation and the simulation for galaxies in 6 fields of the second year HSC shape catalog. The last panel shows the histograms for the galaxies in all of the fields. The blue solid lines are for the observation and the red dashed lines are for the simulation.}}{2}{figure.0.1}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The first 6 panels compare the number histograms of resolution between the observation and the simulation for galaxies in 6 fields of the second year HSC shape catalog. The last panel shows the histograms for the galaxies in all of the fields. The blue solid lines are for the observation and the red dashed lines are for the simulation.}}{3}{figure.0.2}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The first 6 panels compare the number histograms of CModel magnitude between the observation and the simulation for galaxies in 6 fields of the second year HSC shape catalog. The last panel shows the histograms for the galaxies in all of the fields. The blue solid lines are for the observation and the red dashed lines are for the simulation.}}{4}{figure.0.3}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The first 6 panels compare the number histograms of amplitude of ellipticity measured by re-gaussianization algorithm between the observation and the simulation for galaxies in 6 fields of the second year HSC shape catalog. The last panel shows the histograms for the galaxies in all of the fields. The blue solid lines are for the observation and the red dashed lines are for the simulation.}}{5}{figure.0.4}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The left panel shows the shape measurement error per component ($\sigma _e$) estimated with the simulation in different (SNR, resolution) bins. The right panel shows the intrinsic shape ($e_{\rm  {RMS}}$)per component as function of (SNR, resolution). }}{5}{figure.0.5}}
